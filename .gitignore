# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Environment / secrets
.env
.env.*
*.env

# Firebase config (sensitive - never commit)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Supabase
supabase/.temp/
supabase/.branches/
supabase/seed.sql

# Android release signing
android/key.properties
android/*.jks
android/*.keystore

# Release build artifacts (binary)
release_artifacts/**/*.aab
release_artifacts/**/*.apk
releases/

# Generated sales reports / scratch workbooks -- not source
outputs/
tmp_sales_workbook/

# Node / Puppeteer QA
node_modules/
package-lock.json

# QA toolkit (see qa/README.md) -- output and per-project config, not source
qa/screenshots/
qa/results/
qa/config.js
qa/**/*.png
qa/**/*result*.json

# Root-level SQL migration notes -- run manually in the Supabase SQL
# Editor, never committed (this repo is public; these expose schema/RLS
# details that shouldn't be world-readable).
/*.sql
